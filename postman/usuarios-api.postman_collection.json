{
  "info": {
    "_postman_id": "6ecb2d18-1e1d-4aa3-8d0b-usuarios-api",
    "name": "Usuários API",
    "description": "Collection sequencial para validação da API REST de usuários. Os testes usam variáveis de collection e HTTP Basic.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "emailTeste",
      "value": ""
    },
    {
      "key": "senhaAtual",
      "value": "senha123"
    },
    {
      "key": "novaSenha",
      "value": "novaSenha123"
    }
