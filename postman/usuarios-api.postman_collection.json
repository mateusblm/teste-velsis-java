  "item": [
    {
      "name": "01 - Cadastro público válido e resposta sem senha",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Mateus Burlamaqui\",\n  \"email\": \"{{emailTeste}}\",\n  \"senha\": \"{{senhaAtual}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailTeste\", \"mateus.\" + Date.now() + \"@example.com\");",
              "pm.collectionVariables.set(\"senhaAtual\", \"senha123\");",
              "pm.collectionVariables.set(\"novaSenha\", \"novaSenha123\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cadastro retorna 201 Created\", function () {",
              "    pm.expect(pm.response.code).to.eql(201);",
              "});",
              "pm.test(\"Resposta contém id, nome e email e não expõe senha\", function () {",
              "    const resposta = pm.response.json();",
              "    pm.expect(resposta).to.have.property(\"id\");",
              "    pm.expect(resposta).to.have.property(\"nome\", \"Mateus Burlamaqui\");",
              "    pm.expect(resposta).to.have.property(\"email\", pm.collectionVariables.get(\"emailTeste\"));",
              "    pm.expect(resposta).to.not.have.property(\"senha\");",
              "    pm.collectionVariables.set(\"usuarioId\", resposta.id);",
              "});"
            ]
          }
        }
      ]
    },
